{
  "info": {
    "name": "JAVA-W4-004 Enterprise Employee & Resource Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login (admin/admin123)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"hr1\",\n  \"email\": \"hr1@enterprise.com\",\n  \"password\": \"password123\",\n  \"role\": \"HR_MANAGER\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "Departments - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"departmentName\": \"Information Technology\",\n  \"departmentHead\": \"Rajesh Kulkarni\",\n  \"location\": \"Pune\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/departments", "host": ["{{baseUrl}}"], "path": ["api", "departments"] }
      }
    },
    {
      "name": "Departments - Get All",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/departments", "host": ["{{baseUrl}}"], "path": ["api", "departments"] }
      }
    },
    {
      "name": "Employees - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Aishwaryaa\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"aish@enterprise.com\",\n  \"phone\": \"9876543210\",\n  \"dateOfJoining\": \"2026-01-15\",\n  \"designation\": \"Java Developer\",\n  \"salary\": 60000,\n  \"employmentType\": \"FULL_TIME\",\n  \"departmentId\": 1,\n  \"location\": \"Pune\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] }
      }
    },
    {
      "name": "Employees - Search/Filter/Paginate",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/employees?department=Information Technology&status=ACTIVE&page=0&size=10&sort=firstName,asc",
          "host": ["{{baseUrl}}"], "path": ["api", "employees"],
          "query": [
            { "key": "department", "value": "Information Technology" },
            { "key": "status", "value": "ACTIVE" },
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "sort", "value": "firstName,asc" }
          ]
        }
      }
    },
    {
      "name": "Projects - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"projectName\": \"Core Banking Revamp\",\n  \"description\": \"Modernizing core banking backend\",\n  \"clientName\": \"ABC Bank\",\n  \"startDate\": \"2026-08-01\",\n  \"budget\": 500000,\n  \"projectManagerId\": 1,\n  \"priority\": \"HIGH\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
      }
    },
    {
      "name": "Projects - Update Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"projectStatus\": \"ACTIVE\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/projects/1/status", "host": ["{{baseUrl}}"], "path": ["api", "projects", "1", "status"] }
      }
    },
    {
      "name": "Allocations - Allocate Employee",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"employeeId\": 1,\n  \"projectId\": 1,\n  \"role\": \"Backend Developer\",\n  \"allocationPercentage\": 80,\n  \"startDate\": \"2026-08-15\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/allocations", "host": ["{{baseUrl}}"], "path": ["api", "allocations"] }
      }
    },
    {
      "name": "Leaves - Submit",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"employeeId\": 1,\n  \"leaveType\": \"CASUAL\",\n  \"startDate\": \"2026-08-20\",\n  \"endDate\": \"2026-08-21\",\n  \"reason\": \"Personal work\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/leaves", "host": ["{{baseUrl}}"], "path": ["api", "leaves"] }
      }
    },
    {
      "name": "Leaves - Approve/Reject",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"approvedBy\": \"admin\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/leaves/1/decision", "host": ["{{baseUrl}}"], "path": ["api", "leaves", "1", "decision"] }
      }
    },
    {
      "name": "Dashboard - Summary",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "summary"] }
      }
    }
  ]
}
